<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="bstBuilderAnalyzerGUI.MainWindow"
    Title="bstBuilderAnalyzerGUI">
    <StackPanel>
        <Grid ColumnDefinitions="100, 100" RowDefinitions="Auto">
            <TextBox Name="insertInput" Grid.Row="0" Grid.Column="0" Watermark="Input integer..."/>
            <Button Grid.Row="0" Grid.Column="1" Click="insertInt">Submit</Button>
        </Grid>
        <Grid ColumnDefinitions="100, 100, 100" RowDefinitions="Auto">
            <Button Grid.Row="0" Grid.Column="0" Click="traverse">Traverse</Button>
            <ComboBox Name="traversalType" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem>Preorder</ComboBoxItem>
                <ComboBoxItem>Inorder</ComboBoxItem>
                <ComboBoxItem>Postorder</ComboBoxItem>
                <ComboBoxItem>Level-order</ComboBoxItem>
            </ComboBox>
            <Button Grid.Row="0" Grid.Column="2" Click="showAnalytics">Analytics</Button>
        </Grid>
    </StackPanel>
</Window>
